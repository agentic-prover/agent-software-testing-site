{
  "schema": "agent-software-testing/site-spec@0.1",
  "image": "Ubuntu 22.04",
  "coverage_compiler": "gcc and gcov 11.4",
  "lcov": "1.14",
  "coverage_flags": "-O0 --coverage",
  "sanitiser_compiler": "clang 15",
  "interval_s": 900,
  "time_limit_default_s": 30,
