  "min_repeats": 3,
  "standard_budget_h": 6,
  "disclosure_days": 90,
  "flake_branches_hint": 10,
  "term_grace_s": 2,
  "spec_version": "0.1 (draft)",
  "acceptance_full": 1,
  "built_programs": 3
}
